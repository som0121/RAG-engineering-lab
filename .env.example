# Copy this file to .env and fill in your key. Never commit .env.

# Gemini API (only provider used)
GOOGLE_API_KEY=

# Which model the scripts use, as "provider:model-name" (cheap Gemini "lite" tier)
MODEL=google_genai:gemini-3.5-flash-lite

# Embeddings for RAG lessons, as "provider:model-name"
EMBEDDING_MODEL=google_genai:gemini-embedding-001

# Optional: LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lang-course

# Identifies your requests when loading web pages (WebBaseLoader)
USER_AGENT=lang-course/0.1

SUPABASE_DATABASE_URL=
