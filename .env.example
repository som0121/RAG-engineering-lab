# Copy this file to .env and fill in the keys you have. Never commit .env.

# Which model the scripts use, as "provider:model-name"
MODEL=openrouter:anthropic/claude-haiku-5.5
# MODEL=openai:gpt-4o-mini
# MODEL=google_genai:gemini-2.5-flash
# MODEL=openrouter:anthropic/claude-fable-5.1

OPENROUTER_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lang-course

# Identifies your requests when loading web pages (WebBaseLoader)
USER_AGENT=lang-course/0.1

# Embeddings for RAG lessons, as "provider:model-name"
EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small
